---
import '@/styles/global.css';
import { TEMPLE_INFO } from '@/data/temple';
import Header from '@/components/Header.astro';
import MobileBottomBar from '@/components/MobileBottomBar.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schemaType?: 'HinduTemple' | 'WebPage';
}

const {
  title,
  description,
  ogImage = '/og-preview.jpg',
  schemaType = 'HinduTemple'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://srivenkateswaraswamytemple-kovai.org').toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://srivenkateswaraswamytemple-kovai.org').toString();
const fullTitle = title.includes(TEMPLE_INFO.name) ? title : `${title} | ${TEMPLE_INFO.name}`;

// Structured data includes only verified temple identity, address, and map link.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType === 'HinduTemple' ? 'HinduTemple' : 'WebPage',
  name: TEMPLE_INFO.name,
  alternateName: TEMPLE_INFO.alternateName,
  description,
  url: canonicalUrl,
  ...(schemaType === 'HinduTemple'
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: `${TEMPLE_INFO.address.plusCode}, ${TEMPLE_INFO.address.locality}, ${TEMPLE_INFO.address.area}`,
          addressLocality: TEMPLE_INFO.address.city,
          addressRegion: TEMPLE_INFO.address.state,
          postalCode: TEMPLE_INFO.address.postalCode,
          addressCountry: 'IN'
        },
        hasMap: TEMPLE_INFO.googleMapsUrl
      }
    : {})
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#2D070D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social & Messaging Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={TEMPLE_INFO.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Cormorant Garamond + Cinzel + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileBottomBar currentPath={Astro.url.pathname} />
  </body>
</html>
