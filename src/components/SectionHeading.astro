---
import OrnamentalDivider from './OrnamentalDivider.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  tone?: 'dark' | 'light';
}

const { eyebrow, title, subtitle, align = 'center', tone = 'dark' } = Astro.props;
---

<header class:list={['section-heading', `align-${align}`, `tone-${tone}`]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  {align === 'center' && (
    <OrnamentalDivider tone={tone === 'light' ? 'ivory' : 'gold'} compact />
  )}
  {subtitle && <p class="subtitle">{subtitle}</p>}
</header>

<style>
  .section-heading {
    margin-bottom: var(--space-8);
  }

  .align-center {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
  }

  .align-left {
    text-align: left;
    max-width: 720px;
  }

  .tone-light h2 {
    color: var(--color-gold-soft);
  }

  .subtitle {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-brown-muted);
  }

  .tone-light .subtitle {
    color: rgba(250, 245, 235, 0.86);
  }
</style>
