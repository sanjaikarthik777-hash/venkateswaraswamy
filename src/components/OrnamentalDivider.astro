---
interface Props {
  tone?: 'gold' | 'maroon' | 'ivory';
  compact?: boolean;
}

const { tone = 'gold', compact = false } = Astro.props;
const color =
  tone === 'ivory' ? '#EFE0B6' : tone === 'maroon' ? '#4A0E17' : '#C59B43';
---

<div class:list={['ornament-divider', { compact }]} aria-hidden="true">
  <span class="line" style={`background:${color}`}></span>
  <svg width="46" height="18" viewBox="0 0 46 18" fill="none">
    <path
      d="M23 2C25.2 6.2 27.6 8.2 32 9C27.6 9.8 25.2 11.8 23 16C20.8 11.8 18.4 9.8 14 9C18.4 8.2 20.8 6.2 23 2Z"
      stroke={color}
      stroke-width="1.4"
      fill="none"
    />
    <circle cx="23" cy="9" r="2" fill={color} />
    <circle cx="8" cy="9" r="1.5" fill={color} />
    <circle cx="38" cy="9" r="1.5" fill={color} />
  </svg>
  <span class="line" style={`background:${color}`}></span>
</div>

<style>
  .ornament-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-block: var(--space-4);
    opacity: 0.9;
  }

  .ornament-divider.compact {
    margin-block: var(--space-2);
  }

  .ornament-divider .line {
    height: 1px;
    width: clamp(38px, 14vw, 96px);
    opacity: 0.45;
  }
</style>
