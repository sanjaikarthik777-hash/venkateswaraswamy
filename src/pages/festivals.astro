---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoticeBanner from '@/components/NoticeBanner.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { TEMPLE_INFO } from '@/data/temple';
import { FESTIVALS_CONFIG } from '@/data/festivals';
import { ANNOUNCEMENTS } from '@/data/announcements';
import { ILLUSTRATION_ASSETS } from '@/data/gallery';
---

<BaseLayout
  title="Festivals & Events"
  description={`Upcoming festivals, special announcements, and editable utsavam calendar for ${TEMPLE_INFO.name}, Peelamedu, Coimbatore.`}
>
  <section class="page-banner">
    <div class="container">
      <span class="eyebrow" style="color: var(--color-gold-bright)">Utsavams &amp; Announcements</span>
      <h1>Festivals &amp; Events</h1>
      <p>
        Confirmed festival schedules and official announcements from {TEMPLE_INFO.name}.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container festivals-wrap">
      <NoticeBanner
        tone="festival"
        title="Confirmed Dates Policy"
        message={FESTIVALS_CONFIG.notice}
      />

      <div>
        <SectionHeading
          eyebrow="Sacred Calendar"
          title="Festivals &amp; Special Observances"
          subtitle="Event cards below are maintained in an easily editable data file so the temple team can publish confirmed dates."
          align="left"
        />

        <div class="grid-auto-cards grid-auto-cards-3">
          {FESTIVALS_CONFIG.events.map((event) => (
            <article class="heritage-card event-card">
              <div class="event-img-wrap">
                <Picture
                  src={ILLUSTRATION_ASSETS[event.imageKey]}
                  alt={`Illustrative devotional artwork representing ${event.name}`}
                  formats={['avif', 'webp']}
                  widths={[380, 680]}
                  sizes="(max-width: 639px) 100vw, 33vw"
                  loading="lazy"
                />
                <span class="illustrative-badge">Illustrative Art</span>
              </div>

              <div class="event-card-body">
                <span class:list={['status-pill', event.confirmed ? 'status-pill-verified' : 'status-pill-pending']}>
                  {event.announcementNote}
                </span>
                <h3>{event.name}</h3>
                <p class="event-datetime">
                  <strong>Date:</strong> {event.dateText}<br />
                  <strong>Time:</strong> {event.timeText}
                </p>
                <p class="event-summary">{event.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div>
        <SectionHeading
          eyebrow="Official Updates"
          title="Important Announcements"
          align="left"
        />

        <div class="announcements-stack">
          {ANNOUNCEMENTS.map((notice) => (
            <article class="heritage-card heritage-card-gold notice-item">
              <div class="notice-row-head">
                <span class="status-pill status-pill-verified">{notice.badge}</span>
                <span class="notice-date">{notice.dateLabel}</span>
              </div>
              <h3>{notice.title}</h3>
              <p>{notice.message}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .festivals-wrap {
    display: grid;
    gap: var(--space-10);
  }

  .event-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .event-img-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: var(--color-maroon-dark);
  }

  .event-img-wrap :global(picture),
  .event-img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-card-body {
    padding: var(--space-5);
  }

  .event-card-body h3 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
    font-size: 1.3rem;
  }

  .event-datetime {
    font-size: var(--text-sm);
    color: var(--color-temple-red);
    margin-bottom: var(--space-3);
  }

  .event-summary {
    font-size: var(--text-sm);
    color: var(--color-brown-muted);
    margin: 0;
  }

  .announcements-stack {
    display: grid;
    gap: var(--space-4);
  }

  .notice-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .notice-date {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-brown-muted);
  }

  .notice-item p {
    font-size: var(--text-sm);
    color: var(--color-brown-muted);
    margin: 0;
  }
</style>
