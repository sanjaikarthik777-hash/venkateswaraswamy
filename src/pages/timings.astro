---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoticeBanner from '@/components/NoticeBanner.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { TEMPLE_INFO } from '@/data/temple';
import { DARSHAN_CONFIG } from '@/data/timings';
---

<BaseLayout
  title="Darshan Timings"
  description={`Darshan and opening timing information for ${TEMPLE_INFO.name}, Peelamedu, Coimbatore. Verify festival schedule changes before visiting.`}
>
  <section class="page-banner">
    <div class="container">
      <span class="eyebrow" style="color: var(--color-gold-bright)">Visitor Information</span>
      <h1>Darshan Timings</h1>
      <p>
        Morning and evening darshan schedules for {TEMPLE_INFO.name} ({TEMPLE_INFO.alternateName}).
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container timings-container">
      <NoticeBanner
        tone="verification"
        title="Schedule Confirmation Notice"
        message={DARSHAN_CONFIG.verificationNotice}
      />

      <div class="schedule-table-wrap heritage-card heritage-card-gold">
        <SectionHeading
          eyebrow="Daily Worship Hours"
          title="Morning &amp; Evening Sessions"
          align="left"
        />

        <div class="session-list">
          {DARSHAN_CONFIG.sessions.map((item) => (
            <div class="session-row">
              <div class="session-title-col">
                <h3>{item.session}</h3>
                <span class:list={['status-pill', item.confirmed ? 'status-pill-verified' : 'status-pill-pending']}>
                  {item.confirmed ? 'Confirmed' : 'To Be Confirmed'}
                </span>
              </div>
              <div class="session-detail-col">
                <p class="session-time">{item.timing}</p>
                <p class="session-notes">{item.notes}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <NoticeBanner
        tone="festival"
        title="Festival &amp; Special Occasion Changes"
        message={DARSHAN_CONFIG.festivalNotice}
      />

      <div class="timings-actions">
        <a href={TEMPLE_INFO.contact.phoneHref} class="btn btn-primary">
          Call to Confirm ({TEMPLE_INFO.contact.phoneDisplay})
        </a>
        <a
          href={TEMPLE_INFO.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline-maroon"
        >
          Get Directions
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .timings-container {
    display: grid;
    gap: var(--space-6);
    max-width: 860px;
  }

  .session-list {
    display: grid;
    gap: var(--space-4);
  }

  .session-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-ivory-warm);
    border: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 680px) {
    .session-row {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-5);
      align-items: center;
    }
  }

  .session-title-col h3 {
    margin-bottom: 0.35rem;
    font-size: 1.25rem;
  }

  .session-time {
    font-weight: 700;
    color: var(--color-temple-red);
    margin-bottom: 0.25rem;
  }

  .session-notes {
    font-size: var(--text-sm);
    color: var(--color-brown-muted);
    margin: 0;
  }

  .timings-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
